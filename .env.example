# --- Session API ---
SESSION_API_HOST=127.0.0.1
SESSION_API_PORT=3456
# Bearer token required for all /api/* requests (except /health).
# Generate with: openssl rand -hex 32
SESSION_API_TOKEN=change-me-to-a-long-random-token

# --- OpenCode ---
# How the Session API reaches OpenCode. Empty = auto-discover local background service.
OPENCODE_URL=
OPENCODE_TOKEN=
OPENCODE_DIRECTORY=/home/hdlrocha/vulkan-engine
OPENCODE_DEFAULT_AGENT=build

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Optional file fallback for the token (mode 0600). Written by the in-OpenCode
# `/telegram <bot-token>` command; env TELEGRAM_BOT_TOKEN wins when set.
TELEGRAM_TOKEN_FILE=./data/telegram-token
# Comma-separated Telegram user/chat IDs allowed to use the bot.
TELEGRAM_ALLOWED_USERS=123456789
# Optional project directories offered by the in-plugin /menu picker
# (comma-separated). Session working directories are added automatically.
#TELEGRAM_PROJECTS=/home/hdlrocha/vulkan-engine,/home/hdlrocha/opencode-talk
# Where the chat->session mapping is persisted.
SESSION_MAPPING_FILE=./data/session-mapping.json
# Per-chat project selections for /project (chat id -> directory).
TELEGRAM_PROJECTS_FILE=./data/telegram-projects.json
# Optional single-poller lock override. Telegram allows only one getUpdates
# consumer per bot token; the first OpenCode server (or standalone bot) to
# start polls, the others run in secondary mode (no polling; topic linking and
# sends still work) instead of fighting with 409 Conflict. Defaults to
# <repo>/data/telegram-bot-<token>.lock so servers with different working
# directories still share it. Point at an absolute path when the plugin is
# installed in more than one place.
#TELEGRAM_LOCK_FILE=/home/hdlrocha/opencode-talk/data/telegram-bot.lock

# --- XMPP ---
# Bot account JID + password. XMPP_BOT_TOKEN is an alias for XMPP_PASSWORD so
# `/xmpp <token>` (single password form) also works via env.
#XMPP_JID=opencode-talk@example.com
#XMPP_PASSWORD=change-me
#XMPP_BOT_TOKEN=
# Optional file fallback for the account (JID on line 1, password on line 2,
# mode 0600). Written by the in-OpenCode `/xmpp <jid> <password>` command;
# env wins when set.
XMPP_ACCOUNT_FILE=./data/xmpp-account
XMPP_STATE_FILE=./data/xmpp-state.json
# Comma-separated contact JIDs allowed to use the bot (bare JIDs).
XMPP_ALLOWED_USERS=user@example.com
# Optional MUC room hosting one thread per session (state file wins when set).
#XMPP_MUC=talk@conference.example.com
# Optional project directories offered by the XMPP /menu picker
# (comma-separated, falls back to TELEGRAM_PROJECTS). Session working
# directories are added automatically.
#XMPP_PROJECTS=/home/hdlrocha/vulkan-engine,/home/hdlrocha/opencode-talk
# Where the XMPP contact->session mapping is persisted (JID keys).
XMPP_MAPPING_FILE=./data/xmpp-mapping.json
# Per-contact project selections for /project (contact JID -> directory).
XMPP_PROJECTS_FILE=./data/xmpp-projects.json

# --- Media (agent image uploads) ---
# On-disk store for images agents send to chats.
MEDIA_DIR=./data/media
# Max single image in MB (agent tool caps at 4MB regardless).
MEDIA_MAX_MB=5

# --- Nostr ---
# Comma-separated relay URLs. Empty = Nostr adapter refuses to start.
# Note: relay.damus.io silently drops kind-4 DMs — use relays that store them.
NOSTR_RELAYS=wss://nos.lol,wss://relay.snort.social
# Globally authorized peers (npub or hex, comma-separated). Peers paired per
# session with the Telegram /nostr command also work when this is empty.
NOSTR_ALLOWED_NPUBS=
# Per-session secret keys (nsec, mode 0600 — NEVER commit or share).
NOSTR_KEYS_FILE=./data/nostr-keys.json
# Per-session peer pairings (sessionID -> peer pubkey).
NOSTR_PEERS_FILE=./data/nostr-peers.json
# Per-peer project selections for /project (peer pubkey -> directory).
NOSTR_PROJECTS_FILE=./data/nostr-projects.json
# Optional Blossom server for image URLs over Nostr (e.g. https://nostr.download).
# Unset = image events arrive as text notes instead of URLs.
NOSTR_BLOSSOM_SERVER=

# --- Misc ---
LOG_LEVEL=info
